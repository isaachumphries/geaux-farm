      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_profile\" (\"id\" INTEGER NOT NULL, \"city\" TEXT NOT NULL, \"admin1\" TEXT NOT NULL, \"country_code\" TEXT NOT NULL, \"postcode\" TEXT NULL, \"lat\" REAL NOT NULL, \"lon\" REAL NOT NULL, \"timezone\" TEXT NOT NULL, \"goals\" TEXT NOT NULL, \"goal_other_text\" TEXT NULL, \"experience\" TEXT NOT NULL, \"heard_from\" TEXT NULL, \"heard_other_text\" TEXT NULL, \"availability\" TEXT NOT NULL, \"units\" TEXT NOT NULL, \"notifications_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"notifications_enabled\" IN (0, 1)), \"notification_permission_asked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"notification_permission_asked\" IN (0, 1)), \"first_plant_prompt_dismissed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"first_plant_prompt_dismissed\" IN (0, 1)), \"onboarding_completed_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "spaces",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"spaces\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"area_sq_ft\" INTEGER NOT NULL, \"sun\" TEXT NOT NULL, \"sun_unsure\" INTEGER NOT NULL CHECK (\"sun_unsure\" IN (0, 1)), \"rain_exposed\" INTEGER NOT NULL CHECK (\"rain_exposed\" IN (0, 1)), \"in_container_default\" INTEGER NOT NULL CHECK (\"in_container_default\" IN (0, 1)), \"is_primary\" INTEGER NOT NULL CHECK (\"is_primary\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "climate_months",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"climate_months\" (\"month\" INTEGER NOT NULL, \"avg_low_f\" REAL NOT NULL, \"avg_high_f\" REAL NOT NULL, \"precip_in\" REAL NOT NULL, \"rh_pct\" REAL NOT NULL, \"cloud_pct\" REAL NOT NULL, \"sunshine_hours\" REAL NOT NULL, PRIMARY KEY (\"month\"));"
        }
      ]
    },
    {
      "name": "climate_meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"climate_meta\" (\"id\" INTEGER NOT NULL, \"annual_extreme_min_f\" REAL NOT NULL, \"annual_precip_in\" REAL NOT NULL, \"annual_rh_pct\" REAL NOT NULL, \"zone\" TEXT NOT NULL, \"zone_source\" TEXT NOT NULL, \"last_spring_frost_doy\" INTEGER NULL, \"first_fall_frost_doy\" INTEGER NULL, \"lat\" REAL NOT NULL, \"lon\" REAL NOT NULL, \"computed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "weather_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"weather_days\" (\"date\" TEXT NOT NULL, \"weather_code\" INTEGER NOT NULL, \"tmax_f\" REAL NOT NULL, \"tmin_f\" REAL NOT NULL, \"precip_in\" REAL NOT NULL, \"precip_prob\" INTEGER NULL, \"uv_max\" REAL NULL, \"sunshine_s\" REAL NOT NULL, \"daylight_s\" REAL NOT NULL, \"et0_in\" REAL NOT NULL, \"sunrise\" TEXT NOT NULL, \"sunset\" TEXT NOT NULL, \"fetched_at\" INTEGER NOT NULL, PRIMARY KEY (\"date\"));"
        }
      ]
