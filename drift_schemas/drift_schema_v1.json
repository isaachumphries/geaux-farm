        }
      ]
    },
    {
      "name": "plantings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plantings\" (\"id\" TEXT NOT NULL, \"plant_id\" TEXT NOT NULL, \"space_id\" TEXT NOT NULL, \"nickname\" TEXT NOT NULL, \"setup\" TEXT NOT NULL, \"in_container\" INTEGER NOT NULL CHECK (\"in_container\" IN (0, 1)), \"start_method\" TEXT NOT NULL, \"planted_on\" INTEGER NULL, \"status\" TEXT NOT NULL, \"project_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
